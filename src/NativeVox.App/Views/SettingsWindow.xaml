<Window x:Class="NativeVox.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeVox Settings"
        Width="520" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="NativeVox Settings" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

        <!-- Settings Groups -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Model Selection -->
                <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Whisper Model" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ModelSelector"
                                  Height="32"
                                  Background="#0F172A"
                                  Foreground="#000000"
                                  BorderBrush="#475569"
                                  SelectionChanged="OnModelChanged"/>
                        <TextBlock x:Name="ModelStatusText" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,8"/>
                        <Button x:Name="DownloadModelButton" Content="Download This Model"
                                Width="160" Height="30" HorizontalAlignment="Left"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="OnDownloadModelClicked"/>
                    </StackPanel>
                </Border>

                <!-- Hardware Acceleration -->
                <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Hardware Acceleration" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ProviderSelector"
                                  Height="32"
                                  Background="#0F172A"
                                  Foreground="#000000"
                                  BorderBrush="#475569"/>
                        <TextBlock Text="CUDA provides ultra-low latency. CPU fallback is used automatically if unavailable."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Preferences -->
                <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Typing &amp; Interface" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ProgressiveTypingCheckBox" Content="Direct Progressive Typing (live diff &amp; backspace)"
                                  Foreground="#E2E8F0" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="PulsingHudCheckBox" Content="Show Cursor Pulsing Ring HUD while recording"
                                  Foreground="#E2E8F0" Margin="0,0,0,8" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Open Logs Folder" Height="32" Padding="12,0" Background="#334155" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" Click="OnOpenLogsClicked"/>
                    <Button x:Name="RelaunchAdminButton" Content="Relaunch as Administrator" Height="32" Padding="12,0"
                            Background="#D97706" Foreground="White" BorderThickness="0" Cursor="Hand" Click="OnRelaunchAdminClicked"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Button -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Save &amp; Close"
                    Height="38" Width="140"
                    HorizontalAlignment="Right"
                    Background="#10B981" Foreground="White"
                    FontWeight="SemiBold" FontSize="13"
                    BorderThickness="0" Cursor="Hand"
                    Click="OnSaveClicked"/>
        </Grid>
    </Grid>
</Window>
