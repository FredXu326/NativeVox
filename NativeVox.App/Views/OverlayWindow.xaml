<Window x:Class="NativeVox.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeVox Overlay"
        Width="72" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False">

    <Window.Resources>
        <!-- Continuous Subtle Breathing Animation -->
        <Storyboard x:Key="PulsingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.4" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRingScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.4" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0.1" Duration="0:0:1.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="70" Height="70">
        <!-- Outer Glowing Pulsing Ring -->
        <Ellipse x:Name="PulseRing"
                 Width="46" Height="46"
                 Stroke="#60A5FA"
                 StrokeThickness="2"
                 Opacity="0.7"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5, 0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseRingScale" ScaleX="1.0" ScaleY="1.0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Inner Microphone Container -->
        <Border Width="42" Height="42"
                CornerRadius="21"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Clean Modern Microphone Vector Glyph -->
                <Canvas Width="20" Height="20">
                    <!-- Mic capsule -->
                    <Rectangle Canvas.Left="6" Canvas.Top="2" Width="8" Height="10" RadiusX="4" RadiusY="4" Fill="#F8FAFC"/>
                    <!-- Mic arc cradle -->
                    <Path Data="M 4 8 A 6 6 0 0 0 16 8" Stroke="#F8FAFC" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <!-- Mic vertical stem -->
                    <Line X1="10" Y1="14" X2="10" Y2="17.5" Stroke="#F8FAFC" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                    <!-- Mic base stand -->
                    <Line X1="6" Y1="17.5" X2="14" Y2="17.5" Stroke="#F8FAFC" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
